#!/usr/bin/env python
from misc.utility.scons_hints import *

import hashlib
import importlib.util
import json
import os
import subprocess
import sys

from methods import print_error, print_warning

Import("env")
Import("env_modules")

env_dlss = env_modules.Clone()


def _generate_allowlist_header(target, source, env):
    src_path = str(source[0])
    out_path = str(target[0])
    rows = []
    if os.path.isfile(src_path):
        with open(src_path, "r", encoding="utf-8") as f:
            in_table = False
            for raw_line in f:
                line = raw_line.strip()
                if not line.startswith("|"):
                    in_table = False
                    continue
                parts = [p.strip().strip("`") for p in line.strip("|").split("|")]
                if len(parts) < 3:
                    continue
                if parts[0].lower() == "vuid" and parts[1].lower().startswith("dll"):
                    in_table = True
                    continue
                if all(set(p) <= {"-", ":"} and len(p) > 0 for p in parts[:3]):
                    continue
                if in_table and parts[0]:
                    rows.append((parts[0], parts[1], parts[2]))

    def _c_esc(s):
        return s.replace("\\", "\\\\").replace('"', '\\"')

    lines = [
        "/* Generated from docs/godotnext/dlss-validation-allowlist.md; do not edit by hand. */",
        "#pragma once",
        "#include <cstdint>",
        "",
        "struct DLSSValidationAllowlistEntry {",
        "\tconst char *vuid;",
        "\tconst char *dll_sha256;",
        "\tconst char *driver;",
        "};",
        "",
        f"static constexpr uint32_t DLSS_VALIDATION_ALLOWLIST_COUNT = {len(rows)}u;",
        "static const DLSSValidationAllowlistEntry DLSS_VALIDATION_ALLOWLIST[] = {",
    ]
    if rows:
        for vuid, sha, drv in rows:
            lines.append(f'\t{{ "{_c_esc(vuid)}", "{_c_esc(sha)}", "{_c_esc(drv)}" }},')
    else:
        lines.append('\t{ "", "", "" },')
    lines.append("};")
    lines.append("")

    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    with open(out_path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))


allowlist_header = env_dlss.CommandNoCache(
    "dlss_validation_allowlist.gen.h",
    "#docs/godotnext/dlss-validation-allowlist.md",
    env_dlss.Action(_generate_allowlist_header, "Generating $TARGET from $SOURCE"),
)

module_obj = []

env_dlss.add_source_files(module_obj, "register_types.cpp")
env_dlss.add_source_files(module_obj, "dlss_backend_mock.cpp")
env_dlss.add_source_files(module_obj, "dlss_upscaler.cpp")
env_dlss.add_source_files(module_obj, "dlss_streamline_d3d12.cpp")
env_dlss.add_source_files(module_obj, "dlss_frame_generation.cpp")

if env["vulkan"]:
    vk_ext_obj = env_dlss.add_source_files(module_obj, "dlss_vulkan_extensions.cpp")
    env_dlss.Depends(vk_ext_obj, allowlist_header)

if env.editor_build:
    env_dlss.add_source_files(module_obj, "editor/dlss_export_plugin.cpp")
    env_dlss.add_source_files(module_obj, "editor/dlss_editor_plugin.cpp")

if env["tests"]:
    env_dlss.Append(CPPDEFINES=["TESTS_ENABLED"])
    test_objs = env_dlss.add_source_files(module_obj, "./tests/*.cpp")
    env_dlss.Depends(test_objs, allowlist_header)

if env["dlss_backend"] == "ngx":
    env_dlss.Append(CPPDEFINES=["DLSS_BACKEND_NGX"])
    env_dlss.Prepend(CPPPATH=[env["dlss_resolved_include"]])

    if env["dlss_dev_runtime"]:
        env_dlss.Append(CPPDEFINES=["DLSS_DEV_RUNTIME"])

    if env["vulkan"]:
        env_dlss.add_source_files(module_obj, "dlss_ngx_vk.cpp")
        env_dlss.add_source_files(module_obj, "dlss_ngx_rr.cpp")

    if env.get("d3d12", False):
        env_dlss.add_source_files(module_obj, "dlss_ngx_d3d12.cpp")

    lib_path = env["dlss_resolved_lib"]
    env.Append(LIBS=[env.File(lib_path)])

    sl_lib = env.get("dlss_resolved_streamline_lib", "")
    sl_include = env.get("dlss_resolved_streamline_include", "")
    if sl_lib and sl_include and env.get("d3d12", False):
        env_dlss.Append(CPPDEFINES=["DLSS_STREAMLINE_ENABLED"])
        env_dlss.Prepend(CPPPATH=[sl_include])
        env.Append(LIBS=[env.File(sl_lib)])
        if env.msvc:
            # Delay-load sl.interposer.dll so runs with FG and Reflex disabled never load Streamline (#209).
            # Ignore LNK4199 so auxiliary targets cloned from env (console wrapper, test stub DLL) link cleanly under /WX.
            env.Append(LINKFLAGS=["delayimp.lib", "/DELAYLOAD:sl.interposer.dll", "/IGNORE:4199"])

    # Copy runtime libraries unmodified into #bin/ and write bin/dlss_runtime.json.
    sdk_root = env["dlss_resolved_sdk"]
    sl_root = env.get("dlss_resolved_streamline_sdk", "")
    license_src = env.get("dlss_resolved_license", "")
    notices_src = env.get("dlss_resolved_notices", "")
    interposer_name = env.get("dlss_resolved_interposer_name", "")
    runtime_files = env.get("dlss_resolved_runtime_files", [])

    copied_targets = []
    for src_path, _variant in runtime_files:
        basename = os.path.basename(src_path)
        if "nvperf" in basename.lower():
            print_error(f"modules/dlss: refusing to copy excluded runtime '{basename}' (U6, #208).")
            sys.exit(255)
        copied_targets.append(
            env.CommandNoCache(
                "#bin/" + basename,
                env.File(src_path),
                Copy("$TARGET", "$SOURCE"),
            )
        )

    license_manifest_name = ""
    if license_src and os.path.isfile(license_src):
        license_manifest_name = os.path.basename(license_src)
        copied_targets.append(
            env.CommandNoCache(
                "#bin/" + license_manifest_name,
                env.File(license_src),
                Copy("$TARGET", "$SOURCE"),
            )
        )

    notices_manifest_name = ""
    if notices_src and os.path.isfile(notices_src):
        notices_manifest_name = os.path.basename(notices_src)
        copied_targets.append(
            env.CommandNoCache(
                "#bin/" + notices_manifest_name,
                env.File(notices_src),
                Copy("$TARGET", "$SOURCE"),
            )
        )

    def _describe_sdk_tag(path):
        try:
            res = subprocess.run(
                ["git", "-C", path, "describe", "--tags", "--exact-match"],
                capture_output=True,
                text=True,
                check=False,
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip()
            res = subprocess.run(
                ["git", "-C", path, "describe", "--tags"],
                capture_output=True,
                text=True,
                check=False,
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip()
        except OSError:
            pass
        return os.path.basename(path) if path else "unknown"

    def _sha256_file(path):
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1024 * 1024), b""):
                h.update(chunk)
        return h.hexdigest()

    def _write_dlss_manifest(target, source, env):
        cfg_path = env.File("#modules/dlss/config.py").abspath
        spec = importlib.util.spec_from_file_location("godotnext_dlss_config", cfg_path)
        cfg_mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(cfg_mod)
        DLSS_SDK_TAG = cfg_mod.DLSS_SDK_TAG
        STREAMLINE_SDK_TAG = cfg_mod.STREAMLINE_SDK_TAG

        detected_tag = _describe_sdk_tag(sdk_root)
        if detected_tag != DLSS_SDK_TAG:
            print_warning(
                f"modules/dlss: SDK tag at '{sdk_root}' is '{detected_tag}', expected pinned tag '{DLSS_SDK_TAG}'."
            )
        variant = "dev" if env["dlss_dev_runtime"] else "rel"
        sha_map = {}
        files_list = []
        for src_path, file_variant in runtime_files:
            basename = os.path.basename(src_path)
            if "nvperf" in basename.lower():
                raise RuntimeError(f"modules/dlss: excluded runtime '{basename}' must not appear in dlss_runtime.json.")
            digest = _sha256_file(src_path)
            sha_map[basename] = digest
            files_list.append(
                {
                    "name": basename,
                    "sha256": digest,
                    "variant": file_variant,
                }
            )
        manifest = {
            "sdk_tag": detected_tag,
            "pinned_tag": DLSS_SDK_TAG,
            "variant": variant,
            "sha256": sha_map,
            "files": files_list,
            "license": license_manifest_name,
            "notices": notices_manifest_name,
        }
        if sl_root:
            manifest["streamline_tag"] = _describe_sdk_tag(sl_root)
            manifest["streamline_pinned_tag"] = STREAMLINE_SDK_TAG
        if interposer_name:
            manifest["interposer"] = interposer_name

        out_path = str(target[0])
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        with open(out_path, "w", encoding="utf-8") as f:
            json.dump(manifest, f, indent=2, sort_keys=True)
            f.write("\n")

    manifest_sig = env.Value(
        (
            sdk_root,
            sl_root,
            license_manifest_name,
            notices_manifest_name,
            interposer_name,
            bool(env["dlss_dev_runtime"]),
            tuple((os.path.basename(p), v) for p, v in runtime_files),
        )
    )
    manifest_cmd = env.CommandNoCache(
        "#bin/dlss_runtime.json",
        copied_targets + [manifest_sig],
        env.Action(_write_dlss_manifest, "Generating DLSS runtime manifest $TARGET"),
    )
    if module_obj:
        env.Depends(module_obj[0], copied_targets + [manifest_cmd])
else:
    env_dlss.Append(CPPDEFINES=["DLSS_BACKEND_MOCK"])

env.modules_sources += module_obj
