#!/usr/bin/env python
from misc.utility.scons_hints import *

import os

Import("env")
Import("env_modules")

env_oidn = env_modules.Clone()

module_obj = []

env_oidn.add_source_files(module_obj, "register_types.cpp")
env_oidn.add_source_files(module_obj, "oidn_denoiser.cpp")

if env["oidn_backend"] == "mock":
    env_oidn.Append(CPPDEFINES=["OIDN_BACKEND_MOCK"])
    env_oidn.add_source_files(module_obj, "oidn_denoiser_mock.cpp")
else:
    env_oidn.Append(CPPDEFINES=["OIDN_BACKEND_OIDN"])
    env_oidn.Prepend(CPPPATH=[env["oidn_resolved_include"]])
    env_oidn.add_source_files(module_obj, "oidn_denoiser_real.cpp")
    env.Append(LIBPATH=[env["oidn_resolved_libpath"]])
    if env.msvc:
        env.Append(LIBS=[env.File(os.path.join(env["oidn_resolved_libpath"], "OpenImageDenoise.lib"))])
    else:
        env.Append(LIBS=["OpenImageDenoise"])

env.modules_sources += module_obj
