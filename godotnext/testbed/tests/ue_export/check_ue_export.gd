## NextGI Perf (#33, #52, #230): the seeded instances in their three feeds (MeshInstance3D nodes,
## 7 MultiMeshes, and GridMap cells as drawn, at the --instances count of the export), the 12
## room boxes, the sun, 16 omnis and the off-screen spot; with --variant=p3 the 4 skinned
## characters as skeletal instances following the spline (world and pose tracks recomputed).
func _check_perf(p_dir: String, p_scene: Dictionary) -> void:
	var manifest: Dictionary = _read_json(p_dir.path_join("export_manifest.json"))
	var count := int(_user_arg(manifest, "--instances", str(PerfLayout.DEFAULT_INSTANCES)))
	var p3 := _user_arg(manifest, "--variant", "") == "p3"
	var plan: Dictionary = PerfLayout.plan(count, PerfLayout.SEED)
	var positions: PackedVector3Array = plan["positions"]
	var kinds: PackedInt32Array = plan["kind"]
	var share := PerfLayout.shares(count)
	var checks: Dictionary = p_scene["checks"]
	_check(int(checks["node_instances"]) == int(share["mesh"]) + 12, "%d MeshInstance3D instances and the 12 room boxes (%d)" % [int(share["mesh"]), int(checks["node_instances"])])
	_check(int(checks["multimesh_instances"]) == int(share["multimesh"]), "%d MultiMesh instances (%d)" % [int(share["multimesh"]), int(checks["multimesh_instances"])])
	_check(int(checks["gridmap_cells"]) == int(share["gridmap"]), "%d GridMap cells (%d)" % [int(share["gridmap"]), int(checks["gridmap_cells"])])
	_check(int(checks["skeletal_instances"]) == (Character.PERF_COUNT if p3 else 0), "the p3 variant's 4 characters (%d)" % int(checks["skeletal_instances"]))
	_check(_int_counts(checks["light_types"]) == {"directional": 1, "omni": 16, "spot": 1}, "the sun, 16 omnis and the off-screen spot (%s)" % checks["light_types"])
	# CaptureCam's far plane (150 m) reaches past the courtyard's far end from every spline frame
	# (#33), so nothing is clipped and the export needs no approximation.
	_check(_approximations(p_scene).is_empty() and int(checks["camera_far_rows"]) == 0, "NextGI Perf needs no approximation and nothing reaches past CaptureCam's far plane (%s, %d rows)" % [_approximations(p_scene).keys(), int(checks["camera_far_rows"])])
	var mesh_size := {}
	for mesh: Dictionary in p_scene["meshes"]:
		mesh_size[String(mesh["id"])] = _vector(mesh["aabb"]["size"])
	var by_bucket := {}
	for index in positions.size():
		var key := "%d:%d" % [kinds[index], index % PerfLayout.ROUGHNESS.size()]
		if not by_bucket.has(key):
			by_bucket[key] = []
		(by_bucket[key] as Array).append(index)
	var off := 0
	var seen := 0
	var first_off: Array[String] = []
	var box := Vector3.ONE * PerfLayout.BOX
	var grid_box := Vector3.ONE * (PerfLayout.BOX / PerfLayout.CELL)
	for instance: Dictionary in p_scene["instances"]:
		var node := String(instance["node"])
		var kind := String(instance["kind"])
		if kind == "node" and node.begins_with("Instances/Meshes/Mesh"):
			var index := int(node.trim_prefix("Instances/Meshes/Mesh"))
			seen += 1
			if kinds[index] != 0 or not _transforms_close(Lib.rows_to_transform(instance["transform"]), Transform3D(Basis(), positions[index])) or not (mesh_size.get(String(instance["mesh"]), Vector3()) as Vector3).is_equal_approx(box):
				off += 1
				if first_off.size() < 3:
					first_off.append(node)
		elif kind == "multimesh":
			var bucket := int(node.trim_prefix("Instances/MultiMeshes/Roughness"))
			var indices: Array = by_bucket.get("1:%d" % bucket, [])
			_check(indices.size() == int(instance["count"]), "MultiMesh %s holds the plan's %d instances" % [node, indices.size()])
			for row in mini(indices.size(), (instance["instances"] as Array).size()):
				seen += 1
				if not _transforms_close(Lib.rows_to_transform(instance["instances"][row]), Transform3D(Basis(), positions[int(indices[row])])):
					off += 1
					if first_off.size() < 3:
						first_off.append("%s row %d" % [node, row])
		elif kind == "gridmap":
			var items: Array = instance["items"]
			_check(items.size() == 1 and node == "Instances/Grid", "a GridMap entry names one item of Instances/Grid (%s %s)" % [node, items])
			_check((mesh_size.get(String(instance["mesh"]), Vector3()) as Vector3).is_equal_approx(grid_box), "GridMap item %s draws its %.1f m box (%s)" % [items, PerfLayout.BOX / PerfLayout.CELL, mesh_size.get(String(instance["mesh"]))])
			var expected := {}
			for index: int in by_bucket.get("2:%d" % int(items[0]), []):
				expected[positions[index]] = true
			_check(expected.size() == int(instance["count"]), "GridMap item %s has the plan's %d cells (%d)" % [items, expected.size(), int(instance["count"])])
			for rows: Array in instance["instances"]:
				seen += 1
				var transform := Lib.rows_to_transform(rows)
				if not transform.basis.is_equal_approx(Basis()) or not expected.has(transform.origin):
					off += 1
					if first_off.size() < 3:
						first_off.append("%s cell %s" % [node, transform.origin])
	_check(seen == positions.size() and off == 0, "every seeded placement is the plan's, in its feed (%d of %d seen, %d differ: %s)" % [seen, positions.size(), off, first_off])
	if not p3:
		return
	var characters := 0
	for instance: Dictionary in p_scene["instances"]:
		if instance["kind"] != "skeletal":
			continue
		var node := String(instance["node"])
		var index := int(node.trim_prefix("P3Characters/PerfCharacter").trim_suffix("/Visual"))
		_check(node == "P3Characters/PerfCharacter%d/Visual" % index, "skeletal instance %s is a perf character" % node)
		characters += 1
		var frames := int(p_scene["frames"])
		var expected_world: Array = []
		var expected_poses: Array = []
		var basis := Basis()
		for frame in frames:
			var travel := PerfLayout.spline_position(frame) - PerfLayout.spline_position(maxi(frame - 1, 0))
			if travel.length_squared() > 1e-8:
				basis = Basis.looking_at(travel, Vector3.UP)
			expected_world.append(Transform3D(basis, Character.perf_position(index, frame)))
			expected_poses.append(_walk_pose(frame, index * 7))
		_check_character_tracks(p_dir, instance, expected_world, expected_poses, true)
	_check(characters == Character.PERF_COUNT, "4 perf characters (%d)" % characters)


## Foliage Field (#148, #234), the plain variant: the ground and two MultiMeshes, 100,000 trees and
## 100,000 grass cards, every placement equal to the generator's seeded field (its own
## _field_transforms streams); nothing moves and nothing reaches past the far plane. The trees' two
## surfaces (trunk and leaf cards) are both drawn with the node's masked leaf material override
## (textured, two-sided, clipped at 0.5), the grass is masked and two-sided without a texture, and
## diffuse_mode names those two materials (Godot's Burley default).
func _check_foliage(p_scene: Dictionary) -> void:
	var checks: Dictionary = p_scene["checks"]
	var total := BuildPn.TREE_COUNT + BuildPn.GRASS_COUNT
	_check(int(checks["node_instances"]) == 1 and int(checks["multimesh_nodes"]) == 2 and int(checks["multimesh_instances"]) == total and int(checks["skeletal_instances"]) == 0 and int(checks["gridmap_cells"]) == 0, "the ground and %d trees and grass cards in two MultiMeshes (%d nodes, %d instances)" % [total, int(checks["node_instances"]), int(checks["multimesh_instances"])])
	_check(int(checks["movers"]) == 0 and int(checks["camera_far_rows"]) == 0, "nothing moves and nothing reaches past cam_main's far plane (%d movers, %d rows)" % [int(checks["movers"]), int(checks["camera_far_rows"])])
	_check(_int_counts(checks["light_types"]) == {"directional": 1}, "the sun (%s)" % checks["light_types"])
	var expected := {
		"Trees": BuildPn._field_transforms(BuildPn.FIELD_STREAM + 1, BuildPn.TREE_COUNT, 0.85, 1.45),
		"Grass": BuildPn._field_transforms(BuildPn.FIELD_STREAM + 2, BuildPn.GRASS_COUNT, 0.7, 1.3),
	}
	var materials := {}
	for material: Dictionary in p_scene["materials"]:
		materials[String(material["id"])] = material
	var surfaces := {}
	for mesh: Dictionary in p_scene["meshes"]:
		surfaces[String(mesh["id"])] = (mesh["surfaces"] as Array).size()
	var found := {}
	var masked := {}
	for instance: Dictionary in p_scene["instances"]:
		var node := String(instance["node"])
		if instance["kind"] == "node":
			_check(node == "Ground", "the only node instance is the ground (%s)" % node)
			continue
		_check(instance["kind"] == "multimesh" and expected.has(node) and not found.has(node), "one MultiMesh entry each for Trees and Grass (%s %s)" % [instance["kind"], node])
		if not expected.has(node) or found.has(node):
			continue
		found[node] = true
		var buffer: PackedFloat32Array = expected[node]
		var rows: Array = instance["instances"]
		_check(rows.size() * 12 == buffer.size() and int(instance["count"]) == rows.size(), "%s holds the field's %d placements (%d)" % [node, buffer.size() / 12, rows.size()])
		var off := 0
		for row in mini(rows.size(), buffer.size() / 12):
			var want := Lib.rows_to_transform(Array(buffer.slice(row * 12, row * 12 + 12)))
			if not _transforms_close(Lib.rows_to_transform(rows[row]), want):
				off += 1
		_check(off == 0, "every %s placement is the generator's seeded transform (%d differ)" % [node, off])
		var ids: Array = instance["materials"]
		_check(ids.size() == int(surfaces.get(String(instance["mesh"]), -1)) and ids.size() == (2 if node == "Trees" else 1), "%s has one material per surface (%d)" % [node, ids.size()])
		# The node's override, not the mesh's own surface materials (which are null, and so export as
		# "default"): every surface's material has the generator's override settings.
		var source: StandardMaterial3D = BuildPn.tree_material() if node == "Trees" else BuildPn.grass_material()
		for id: String in ids:
			var drawn_material: Dictionary = materials.get(id, {})
			var drawn: Dictionary = drawn_material.get("properties", {})
			var is_override := id != "default" and id == String(ids[0]) and is_equal_approx(float(drawn.get("roughness", -1.0)), source.roughness) and int(drawn.get("transparency", -1)) == source.transparency and int(drawn.get("cull_mode", -1)) == source.cull_mode
			_check(is_override, "%s draws every surface with its material override (%s)" % [node, ids])
			masked[id] = true
		var material: Dictionary = materials.get(String(ids[0]) if not ids.is_empty() else "", {})
		_check(String(material.get("blend", "")) == "masked" and bool(material.get("two_sided", false)) and is_equal_approx(float(material.get("alpha_scissor_threshold", 0.0)), 0.5), "%s is masked, two-sided and clipped at 0.5" % node)
		_check((material.get("albedo_texture") != null) == (node == "Trees"), "only the trees' leaf material has an albedo texture (%s: %s)" % [node, material.get("albedo_texture")])
	_check(found.size() == 2, "both MultiMeshes are exported (%s)" % [found.keys()])
	var leaf: Array = p_scene["textures"]
	_check(leaf.size() == 1 and leaf[0]["size"] == [64.0, 64.0] and leaf[0]["usages"] == ["albedo"], "one texture, the 64 x 64 leaf silhouette (%s)" % [leaf])
	var approximations := _approximations(p_scene)
	_check(approximations.keys() == ["diffuse_mode"], "Foliage Field needs diffuse_mode only (%s)" % [approximations.keys()])
	var labels := PackedStringArray()
	for id: String in masked:
		labels.append(_material_label(materials[id]))
	labels.sort()
	var named := PackedStringArray(approximations.get("diffuse_mode", []))
	named.sort()
	_check(named == labels, "diffuse_mode names the leaf and grass materials (%s, %s)" % [named, labels])


## Displacement Cliff (#148, #234): the 200 m heightfield (256 x 128 quads, 65,536 triangles) and the
## floor, still, lit by the sun, with no approximation. The rock is opaque with the seamless 512 x 512
## noise albedo texture (mipmapped), tiled 24 times (uv1_scale) and filtered linearly with mipmaps.
## GodotNext's cliff is baked geometry: no material of the scene displaces it.
func _check_cliff(p_scene: Dictionary) -> void:
	var checks: Dictionary = p_scene["checks"]
	_check(int(checks["node_instances"]) == 2 and int(checks["multimesh_instances"]) == 0 and int(checks["skeletal_instances"]) == 0 and int(checks["gridmap_cells"]) == 0, "the cliff and the floor (%d)" % int(checks["node_instances"]))
	_check(int(checks["movers"]) == 0 and int(checks["camera_far_rows"]) == 0, "nothing moves and nothing reaches past cam_main's far plane")
	_check(_int_counts(checks["light_types"]) == {"directional": 1}, "the sun (%s)" % checks["light_types"])
	_check(_approximations(p_scene).is_empty(), "Displacement Cliff needs no approximation (%s)" % [_approximations(p_scene).keys()])
	var meshes := {}
	for mesh: Dictionary in p_scene["meshes"]:
		meshes[String(mesh["id"])] = mesh
	var materials := {}
	for material: Dictionary in p_scene["materials"]:
		materials[String(material["id"])] = material
	var textures := {}
	for texture: Dictionary in p_scene["textures"]:
		textures[String(texture["id"])] = texture
	var cliffs := 0
	for instance: Dictionary in p_scene["instances"]:
		var node := String(instance["node"])
		var material: Dictionary = materials.get(String((instance["materials"] as Array)[0]) if not (instance["materials"] as Array).is_empty() else "", {})
		if node == "Cliff":
			cliffs += 1
			var mesh: Dictionary = meshes.get(String(instance["mesh"]), {})
			var quads := BuildPn.CLIFF_GRID.x * BuildPn.CLIFF_GRID.y
			_check(int(mesh.get("triangles", 0)) == quads * 2 and String(mesh.get("name", "")) == "CliffHeightfield", "the heightfield has %d triangles (%s)" % [quads * 2, mesh.get("triangles")])
			_check(String(material.get("blend", "")) == "opaque" and String(material.get("name", "")) == "CliffRock", "the rock is opaque (%s)" % material.get("name"))
			_check(material.get("uv1_scale", []) == [24.0, 24.0, 1.0] and material.get("uv1_offset", []) == [0.0, 0.0, 0.0], "the rock texture tiles 24 times (%s)" % [material.get("uv1_scale")])
			_check(String(material.get("texture_filter", "")) == "linear_mipmaps" and bool(material.get("texture_repeat", false)), "the rock texture repeats and filters linearly with mipmaps (%s)" % material.get("texture_filter"))
			var texture: Dictionary = textures.get(String(material.get("albedo_texture", "")), {})
			_check(String(texture.get("class", "")) == "NoiseTexture2D" and texture.get("size", []) == [512.0, 512.0] and bool(texture.get("mipmaps", false)), "the rock's albedo is the 512 x 512 noise texture with mipmaps (%s)" % [texture])
		else:
			_check(node == "Floor" and String(material.get("blend", "")) == "opaque" and material.get("albedo_texture") == null, "the floor is opaque and untextured (%s)" % node)
			_check(Lib.rows_to_transform(instance["transform"]).origin.is_equal_approx(Vector3(0.0, -0.05, -BuildPn.CLIFF_DEPTH_M * 1.2)), "the floor sits under the cliff (%s)" % [instance["transform"]])
	_check(cliffs == 1, "one cliff instance (%d)" % cliffs)


## Dense City Blocks (#63, #231): the ground plane and every building and rooftop-prop placement of
## the variant, as node instances of the kit scenes the generator wrote. The placements, in the
## generator's order (Buildings/Inst<index>_m<recipe>), give the SHA-256 transform fingerprint that the
## committed generators/dense_city/expected.json records for the variant (the generator's own
## formula, recomputed here from the exported transforms). Each kit mesh keeps the triangle count
## expected.json records for its recipe and carries NextGeo virtual geometry (nextgeo true, which the
## UE import maps to Nanite on that mesh); the ground plane carries none. The triangle total is the
## variant's instanced triangles plus the ground's two. The sun and the 8 street lights all cast
## shadows; diffuse_mode names exactly the kit's materials (the glTF importer's default Burley diffuse;
## the ground is Lambert).
func _check_dense_city(p_scene: Dictionary, p_variant: String) -> void:
	var committed: Variant = _read_json("res://generators/dense_city/expected.json")
	_check(committed is Dictionary and (committed["variants"] as Dictionary).has(p_variant) and (committed["variants"] as Dictionary).has("virtual"), "expected.json records the %s and virtual variants" % p_variant)
	if not (committed is Dictionary and (committed["variants"] as Dictionary).has(p_variant) and (committed["variants"] as Dictionary).has("virtual")):
		return
	var expected: Dictionary = committed["variants"][p_variant]
	# Every city variant instances the same kit; the virtual entry lists its meshes in recipe order.
	var recipes: Array = committed["variants"]["virtual"]["meshes"]
	var checks: Dictionary = p_scene["checks"]
	var placements := int(expected["instance_count"])
	_check(int(checks["node_instances"]) == placements + 1 and int(checks["multimesh_instances"]) == 0 and int(checks["skeletal_instances"]) == 0 and int(checks["gridmap_cells"]) == 0, "the ground and %d kit placements as node instances (%d)" % [placements, int(checks["node_instances"])])
	_check(int(checks["triangles_total"]) == int(expected["instanced_triangles"]) + 2, "%d instanced kit triangles plus the ground's 2 (%d)" % [int(expected["instanced_triangles"]), int(checks["triangles_total"])])
	_check(int(checks["movers"]) == 0 and int(checks["camera_far_rows"]) == 0, "nothing moves and nothing reaches past cam_main's far plane (%d movers, %d rows)" % [int(checks["movers"]), int(checks["camera_far_rows"])])
	_check(_int_counts(checks["light_types"]) == {"directional": 1, "omni": 4, "spot": 4}, "the sun, 4 omni and 4 spot street lights (%s)" % checks["light_types"])
	for light: Dictionary in p_scene["lights"]:
		_check(bool(light["properties"].get("shadow_enabled", false)), "%s casts shadows" % light["node"])
		if String(light["type"]) == "directional":
			_check(int(light["properties"].get("directional_shadow_mode", -1)) == DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS, "the sun has 4 PSSM splits")
	var meshes := {}
	for mesh: Dictionary in p_scene["meshes"]:
		meshes[String(mesh["id"])] = mesh
	var materials := {}
	for material: Dictionary in p_scene["materials"]:
		materials[String(material["id"])] = material
	var pattern := RegEx.create_from_string("^Buildings/Inst(\\d+)_m(\\d+)/")
	var ordered := {}
	var recipe_mesh := {}
	var kit_materials := {}
	var grounds := 0
	for instance: Dictionary in p_scene["instances"]:
		var node := String(instance["node"])
		var mesh: Dictionary = meshes.get(String(instance["mesh"]), {})
		var found := pattern.search(node)
		if found == null:
			grounds += 1
			_check(node == "Ground" and String(mesh.get("class", "")) == "PlaneMesh" and int(mesh.get("triangles", 0)) == 2 and not bool(mesh.get("nextgeo", true)), "the only other instance is the 2-triangle ground plane, without virtual geometry (%s, %s)" % [node, mesh.get("class")])
			for id: Variant in instance["materials"]:
				_check(int(materials.get(String(id), {}).get("properties", {}).get("diffuse_mode", -1)) == BaseMaterial3D.DIFFUSE_LAMBERT, "the ground's material is Lambert")
			continue
		var index := int(found.get_string(1))
		var recipe := int(found.get_string(2))
		_check(not ordered.has(index), "placement %d is exported once" % index)
		ordered[index] = [recipe, Lib.rows_to_transform(instance["transform"])]
		if recipe >= 0 and recipe < recipes.size():
			var want: Dictionary = recipes[recipe]
			if not recipe_mesh.has(recipe):
				recipe_mesh[recipe] = String(instance["mesh"])
				_check(int(mesh.get("triangles", -1)) == int(want["triangles"]), "kit mesh %s keeps its %d triangles (%s)" % [want["name"], int(want["triangles"]), mesh.get("triangles")])
				_check(bool(mesh.get("nextgeo", false)), "kit mesh %s carries NextGeo virtual geometry" % want["name"])
			_check(recipe_mesh[recipe] == String(instance["mesh"]), "every %s placement uses one mesh" % want["name"])
		else:
			_check(false, "placement %d names recipe %d" % [index, recipe])
		for id: Variant in instance["materials"]:
			kit_materials[String(id)] = true
	_check(grounds == 1, "one ground plane (%d)" % grounds)
	_check(ordered.size() == placements, "%d placements (%d)" % [placements, ordered.size()])
	var context := HashingContext.new()
	context.start(HashingContext.HASH_SHA256)
	for index in placements:
		if not ordered.has(index):
			_check(false, "placement %d is missing" % index)
			return
		var t: Transform3D = ordered[index][1]
		context.update(("%d %.6f %.6f %.6f %.6f %.6f %.6f %.6f %.6f %.6f %.6f %.6f %.6f\n" % [
			int(ordered[index][0]),
			t.basis.x.x, t.basis.x.y, t.basis.x.z,
			t.basis.y.x, t.basis.y.y, t.basis.y.z,
			t.basis.z.x, t.basis.z.y, t.basis.z.z,
			t.origin.x, t.origin.y, t.origin.z]).to_utf8_buffer())
	var fingerprint := context.finish().hex_encode()
	_check(fingerprint == String(expected["transform_fingerprint"]), "the placements give the committed %s transform fingerprint (%s)" % [p_variant, fingerprint])
	var approximations := _approximations(p_scene)
	_check(approximations.keys() == ["diffuse_mode"], "Dense City needs diffuse_mode only (%s)" % [approximations.keys()])
	var labels := {}
	for id: String in kit_materials:
		labels[_material_label(materials.get(id, {"id": id}))] = true
	var named := {}
	for item: Variant in approximations.get("diffuse_mode", []):
		named[String(item)] = true
	_check(named == labels, "diffuse_mode names exactly the kit's %d materials (%d named)" % [labels.size(), named.size()])


## Character Crowd (#148, #234): the ground and the 100 walkers as skeletal instances of one asset
## (the shared skinned mesh of at least 500,000 triangles), at the generator's 10 x 10 grid places
## with their seeded facings, none moving; each pose track is the walk cycle at the timing row's
## frame and the walker's phase (index x 3 frames), recomputed from the walk animation.
func _check_crowd(p_dir: String, p_scene: Dictionary) -> void:
	var checks: Dictionary = p_scene["checks"]
	_check(int(checks["node_instances"]) == 1 and int(checks["skeletal_instances"]) == BuildPn.CROWD_COUNT and int(checks["skeletal_meshes"]) == 1 and int(checks["multimesh_instances"]) == 0, "the ground and %d walkers of one skeletal mesh (%d, %d, %d)" % [BuildPn.CROWD_COUNT, int(checks["node_instances"]), int(checks["skeletal_instances"]), int(checks["skeletal_meshes"])])
	_check(int(checks["movers"]) == 0 and int(checks["camera_far_rows"]) == 0, "nothing moves and nothing reaches past cam_main's far plane")
	_check(_int_counts(checks["light_types"]) == {"directional": 1}, "the sun (%s)" % checks["light_types"])
	_check(_approximations(p_scene).is_empty(), "Character Crowd needs no approximation (%s)" % [_approximations(p_scene).keys()])
	for asset: Dictionary in p_scene["skeletal_meshes"]:
		_check(int(asset["triangles"]) >= BuildPn.CROWD_TARGET_TRIANGLES and (asset["clips"] as Array).size() == BuildPn.CROWD_COUNT, "the walker asset has at least %d triangles and one clip per walker (%d, %d clips)" % [BuildPn.CROWD_TARGET_TRIANGLES, int(asset["triangles"]), (asset["clips"] as Array).size()])
	# The generator's grid and its facing stream (build_character_crowd), restated.
	var rng := Scaffold.make_rng(BuildPn.CROWD_STREAM + 1)
	var places: Array[Transform3D] = []
	for index in BuildPn.CROWD_COUNT:
		var facing := rng.randf_range(-PI, PI)
		var position := Vector3(float(index % 10) * 2.6 - 11.7, 0.0, float(index / 10) * 2.6 - 11.7)
		places.append(Transform3D(Basis.from_euler(Vector3(0.0, facing, 0.0)), position))
	var seen := {}
	var frames := int(p_scene["frames"])
	for instance: Dictionary in p_scene["instances"]:
		if instance["kind"] != "skeletal":
			continue
		var node := String(instance["node"])
		var index := int(node.trim_prefix("Crowd/Crowd").trim_suffix("/Visual"))
		_check(node == "Crowd/Crowd%03d/Visual" % index and not seen.has(index), "skeletal instance %s is one walker" % node)
		seen[index] = true
		if index < 0 or index >= places.size():
			continue
		_check(instance["track"] == null, "%s stands in place" % node)
		_check(_transforms_close(Lib.rows_to_transform(instance["transform"]), places[index]), "%s stands at its grid place with its seeded facing" % node)
		var poses := _read_pose_track(p_dir.path_join(String(instance["pose_track"])))
		var worst := 0.0 if poses.size() == frames else INF
		for row in mini(poses.size(), frames):
			var want := _walk_pose(row, index * 3)
			var got: PackedFloat32Array = poses[row]
			worst = maxf(worst, _pose_row_difference(got, want) if got.size() == want.size() else INF)
		_check(worst <= 1e-4, "%s pose rows are the walk cycle at its phase (%d frames) on every row (worst %s)" % [node, index * 3, worst])
	_check(seen.size() == BuildPn.CROWD_COUNT, "%d walkers exported (%d)" % [BuildPn.CROWD_COUNT, seen.size()])


## The motion fixture (tests/ue_export/motion_fixture.tscn), still or with --case=mover_far: the box,
## the three MultiMesh boxes, the skinned triangle as one skeletal instance; still, no approximation
## and no row past the far plane; with mover_far, the box as the one mover and camera_far on exactly
## one row (frame 8, the only row its track reaches past the 20 m far plane); and
## both GridMaps' cells against transforms written out from each GridMap's settings rather than
## read from GridMap.get_meshes(): the GridMap's transform times the cell's (its orientation scaled
## by the cell scale, at cell x cell size plus half a cell on each centered axis) times the item's
## mesh transform. GridTurned has a rotated node, non-cubic cells centered on Y and Z only, a cell
## scale of 0.8, an item mesh transform and rotated cells.
func _check_fixture(p_dir: String, p_scene: Dictionary) -> void:
	var checks: Dictionary = p_scene["checks"]
	var turned_cells: Array = Fixture.turned_cells()
	var fixture_case := _user_arg(_read_json(p_dir.path_join("export_manifest.json")), "--case", "none")
	_check(fixture_case in ["none", "mover_far"], "the fixture check reads the still fixture or mover_far (%s)" % fixture_case)
	_check(int(checks["node_instances"]) == 1 and int(checks["multimesh_instances"]) == 3 and int(checks["skeletal_instances"]) == 1, "the box, three MultiMesh boxes and the skinned triangle (%d, %d, %d)" % [int(checks["node_instances"]), int(checks["multimesh_instances"]), int(checks["skeletal_instances"])])
	_check(int(checks["gridmap_cells"]) == 2 + turned_cells.size() and int(checks["gridmap_entries"]) == 2, "two Grid cells and %d GridTurned cells in one entry each (%d)" % [turned_cells.size(), int(checks["gridmap_cells"])])
	if fixture_case == "mover_far":
		_check(_approximations(p_scene).keys() == ["camera_far"] and int(checks["camera_far_rows"]) == 1 and int(checks["movers"]) == 1, "only the box's row 8 reaches past the 20 m far plane, as a mover (%s, %d rows, %d movers)" % [_approximations(p_scene).keys(), int(checks["camera_far_rows"]), int(checks["movers"])])
	else:
		_check(_approximations(p_scene).is_empty() and int(checks["camera_far_rows"]) == 0, "the still fixture needs no approximation (%s)" % [_approximations(p_scene).keys()])
	var expected := {
		# Grid: 1 m cells centered on every axis, at (0, 2.5, -2).
		"Grid": [Transform3D(Basis(), Vector3(-0.5, 3.0, -1.5)), Transform3D(Basis(), Vector3(1.5, 3.0, -1.5))],
		"GridTurned": [],
	}
	var size := Fixture.turned_cell_size()
	var center := Fixture.turned_center()
	var offset := Vector3(size.x * 0.5 * center.x, size.y * 0.5 * center.y, size.z * 0.5 * center.z)
	var scale := Fixture.turned_cell_scale()
	for cell: Array in turned_cells:
		var position := Vector3(cell[0]) * size + offset
		var local := Transform3D((cell[1] as Basis) * Basis.from_scale(Vector3.ONE * scale), position)
		(expected["GridTurned"] as Array).append(Fixture.turned_transform() * local * Fixture.turned_item_transform())
	var found := {}
	for instance: Dictionary in p_scene["instances"]:
		if instance["kind"] != "gridmap":
			continue
		var node := String(instance["node"])
		_check(expected.has(node) and not found.has(node), "one GridMap entry for %s" % node)
		found[node] = true
		var wanted: Array = expected.get(node, [])
		var rows: Array = instance["instances"]
		var matched := 0
		var used := {}
		for transform: Transform3D in wanted:
			for row in rows.size():
				if not used.has(row) and _transforms_close(Lib.rows_to_transform(rows[row]), transform):
					used[row] = true
					matched += 1
					break
		_check(rows.size() == wanted.size() and matched == wanted.size(), "%s: every cell is placed where its cell, orientation, cell scale, centering and item transform put it (%d of %d)" % [node, matched, wanted.size()])
	_check(found.size() == 2, "both GridMaps are exported (%s)" % [found.keys()])


## A walker's world track and pose track against the recomputed rows. Row 0's facing may be the one
## the scene held before the path started (the spline's travel is zero there) when p_free_row0_basis.
func _check_character_tracks(p_dir: String, p_instance: Dictionary, p_world: Array, p_poses: Array, p_free_row0_basis: bool) -> void:
	var node := String(p_instance["node"])
	var rows := _read_track(p_dir.path_join(String(p_instance["track"]))) if p_instance["track"] != null else []
	_check(rows.size() == p_world.size(), "%s has a world track with one row per frame (%d)" % [node, rows.size()])
	var off := 0
	for row in mini(rows.size(), p_world.size()):
		var got: Transform3D = rows[row]
		var want: Transform3D = p_world[row]
		if row == 0 and p_free_row0_basis:
			if not got.origin.is_equal_approx(want.origin) or not (got.basis.is_equal_approx(Basis()) or (rows.size() > 1 and got.basis.is_equal_approx((rows[1] as Transform3D).basis))):
				off += 1
		elif not _transforms_close(got, want, 1e-4):
			off += 1
	_check(off == 0, "%s world track rows are the scene's path (%d differ)" % [node, off])
	var poses := _read_pose_track(p_dir.path_join(String(p_instance["pose_track"])))
	_check(poses.size() == p_poses.size(), "%s has a pose track with one row per frame (%d)" % [node, poses.size()])
	var worst := 0.0
	for row in mini(poses.size(), p_poses.size()):
		var got: PackedFloat32Array = poses[row]
		var want: PackedFloat32Array = p_poses[row]
		if got.size() != want.size():
			worst = INF
			break
		worst = maxf(worst, _pose_row_difference(got, want))
	_check(worst <= 1e-4, "%s pose rows are the walk cycle at each frame (worst %s)" % [node, worst])


## The largest difference between two pose rows (a rotation and its negation are the same).
func _pose_row_difference(p_a: PackedFloat32Array, p_b: PackedFloat32Array) -> float:
	var worst := 0.0
	for base in range(0, p_a.size(), Lib.POSE_STRIDE):
		var dot := 0.0
		for index in range(3, 7):
			dot += p_a[base + index] * p_b[base + index]
		var sign := 1.0 if dot >= 0.0 else -1.0
		for index in Lib.POSE_STRIDE:
			var scale := sign if index >= 3 and index <= 6 else 1.0
			worst = maxf(worst, absf(p_a[base + index] * scale - p_b[base + index]))
	return worst


## The walker's local bone poses (Lib.pose_row order) at a path frame and phase: positions at the
## rests, the walk clip's rotations at (frame + phase) / 60 s wrapped at the 1 s cycle, unit scale.
func _walk_pose(p_frame: int, p_phase: int) -> PackedFloat32Array:
	if _walker_bones.is_empty():
		# The walker's own skeleton builder, without the material make_character adds.
		var skeleton := Skeleton3D.new()
		Character._build_skeleton(skeleton)
		for bone in skeleton.get_bone_count():
			_walker_bones.append([String(skeleton.get_bone_name(bone)), skeleton.get_bone_rest(bone).origin])
		skeleton.free()
	var animation := Character.shared_animation()
	var time := fmod(float(p_frame + p_phase) / 60.0, Character.WALK_CYCLE_SEC)
	var rotations := {}
	for track in animation.get_track_count():
		if animation.track_get_type(track) == Animation.TYPE_ROTATION_3D:
			rotations[String(animation.track_get_path(track).get_concatenated_subnames())] = animation.rotation_track_interpolate(track, time)
	var row := PackedFloat32Array()
	for bone: Array in _walker_bones:
		var position: Vector3 = bone[1]
		var rotation: Quaternion = rotations.get(String(bone[0]), Quaternion())
		row.append_array(PackedFloat32Array([position.x, position.y, position.z, rotation.x, rotation.y, rotation.z, rotation.w, 1.0, 1.0, 1.0]))
	return row


## Each skeletal mesh's glb re-imports with the asset's bones (names, parents, rests), its skin's
## binds, the scene mesh's triangles, vertices, bone indices and weights, and one clip per instance
## whose every row (sampled at row / fps) is that instance's pose track row.
func _check_skeletal(p_dir: String, p_scene: Dictionary) -> void:
	for asset: Dictionary in p_scene["skeletal_meshes"]:
		var id := String(asset["id"])
		var document := GLTFDocument.new()
		var state := GLTFState.new()
		if document.append_from_file(p_dir.path_join(String(asset["file"])), state) != OK:
			_check(false, "%s imports" % asset["file"])
			continue
		# Godot's importer resamples clips at bake_fps (30 by default); sample at the export's rate
		# so each row is a key.
		var root_node := document.generate_scene(state, float(p_scene["fps"]))
		var skeletons := root_node.find_children("*", "Skeleton3D", true, false)
		var instances := root_node.find_children("*", "MeshInstance3D", true, false)
		var players := root_node.find_children("*", "AnimationPlayer", true, false)
		_check(skeletons.size() == 1 and instances.size() == 1 and players.size() == 1, "%s holds one skeleton, one skinned mesh and one animation player" % asset["file"])
		if skeletons.size() != 1 or instances.size() != 1 or players.size() != 1:
			root_node.free()
			continue
		var skeleton := skeletons[0] as Skeleton3D
		var instance := instances[0] as MeshInstance3D
		var player := players[0] as AnimationPlayer
		var bones: Array = asset["bones"]
		var bones_ok := skeleton.get_bone_count() == bones.size()
		for index in mini(skeleton.get_bone_count(), bones.size()):
			var bone: Dictionary = bones[index]
			var parent := skeleton.get_bone_parent(index)
			var parent_name := String(skeleton.get_bone_name(parent)) if parent >= 0 else ""
			var want_parent := String(bones[int(bone["parent"])]["name"]) if int(bone["parent"]) >= 0 else ""
			if String(skeleton.get_bone_name(index)) != String(bone["name"]) or parent_name != want_parent or not _transforms_close(skeleton.get_bone_rest(index), Lib.rows_to_transform(bone["rest"]), 1e-5):
				bones_ok = false
		_check(bones_ok, "%s re-imports with the asset's %d bones, parents and rests" % [id, bones.size()])
		var skin := instance.skin
		var binds: Array = asset["binds"]
		var binds_ok := skin != null and skin.get_bind_count() == binds.size()
		for bind in (mini(skin.get_bind_count(), binds.size()) if skin != null else 0):
			var name := String(skin.get_bind_name(bind))
			if name.is_empty():
				name = String(skeleton.get_bone_name(skin.get_bind_bone(bind)))
			if name != String(binds[bind]["bone"]) or not _transforms_close(skin.get_bind_pose(bind), Lib.rows_to_transform(binds[bind]["pose"]), 1e-5):
				binds_ok = false
		_check(binds_ok, "%s re-imports with the skin's %d binds" % [id, binds.size()])
		var source := _skeletal_source_mesh(p_scene, asset)
		_check(source != null, "%s: the scene's skinned mesh is found for comparison" % id)
		if source != null:
			_check(_skin_arrays_equal(instance.mesh, source), "%s re-imports with the scene mesh's vertices, bone indices and weights" % id)
		var clips_ok := true
		var compared := 0
		var worst := 0.0
		for scene_instance: Dictionary in p_scene["instances"]:
			if scene_instance["kind"] != "skeletal" or String(scene_instance["skeletal"]) != id:
				continue
			var clip := String(scene_instance["clip"])
			if not player.has_animation(clip):
				clips_ok = false
				continue
			var animation := player.get_animation(clip)
			# bone name -> {track type: track index}
			var tracks := {}
			for track in animation.get_track_count():
				var bone_name := String(animation.track_get_path(track).get_concatenated_subnames())
				if not tracks.has(bone_name):
					tracks[bone_name] = {}
				tracks[bone_name][animation.track_get_type(track)] = track
			var poses := _read_pose_track(p_dir.path_join(String(scene_instance["pose_track"])))
			for row in poses.size():
				var time := float(row) / float(p_scene["fps"])
				var want: PackedFloat32Array = poses[row]
				for bone in bones.size():
					# Godot's importer drops the tracks that never change (the clip keys all three on
					# every row): those hold the bone's rest.
					var by_type: Dictionary = tracks.get(String(bones[bone]["name"]), {})
					var position_track := int(by_type.get(Animation.TYPE_POSITION_3D, -1))
					var rotation_track := int(by_type.get(Animation.TYPE_ROTATION_3D, -1))
					var scale_track := int(by_type.get(Animation.TYPE_SCALE_3D, -1))
					var rest := skeleton.get_bone_rest(bone)
					var position := animation.position_track_interpolate(position_track, time) if position_track >= 0 else rest.origin
					var rotation := animation.rotation_track_interpolate(rotation_track, time) if rotation_track >= 0 else rest.basis.get_rotation_quaternion()
					var scale := animation.scale_track_interpolate(scale_track, time) if scale_track >= 0 else rest.basis.get_scale()
					var base := bone * Lib.POSE_STRIDE
					var got := [position.x, position.y, position.z, rotation.x, rotation.y, rotation.z, rotation.w, scale.x, scale.y, scale.z]
					var sign := 1.0 if Quaternion(want[base + 3], want[base + 4], want[base + 5], want[base + 6]).dot(rotation) >= 0.0 else -1.0
					for index in Lib.POSE_STRIDE:
						var value := float(got[index]) * (sign if index >= 3 and index <= 6 else 1.0)
						worst = maxf(worst, absf(value - want[base + index]))
					compared += 1
		_check(clips_ok and compared > 0 and worst <= 1e-4, "%s: every instance clip re-imports and holds its pose track at every row (%d bone rows compared, worst %s)" % [id, compared, worst])
		root_node.free()


## The scene's own skinned mesh an asset was made from (for the re-import comparison).
func _skeletal_source_mesh(p_scene: Dictionary, p_asset: Dictionary) -> Mesh:
	if _scene_path == String(SCENES["walk"]["scene"]) or _scene_path == String(SCENES["crowd"]["scene"]):
		# Read from the packed scene's state, without instancing its nodes (every walker of the crowd
		# shares one mesh).
		var visual := "Character/Visual" if _scene_path == String(SCENES["walk"]["scene"]) else "Crowd/Crowd000/Visual"
		var state := (load(_scene_path) as PackedScene).get_state()
		for node in state.get_node_count():
			if String(state.get_node_path(node)).trim_prefix("./") != visual:
				continue
			for property in state.get_node_property_count(node):
				if state.get_node_property_name(node, property) == &"mesh":
					return state.get_node_property_value(node, property)
		return null
	if _scene_path == String(SCENES["perf"]["scene"]):
		return Character.shared_mesh()
	if _scene_path == String(SCENES["fixture"]["scene"]):
		# The fixture builds its nodes in _init.
		var shell := (load(_scene_path) as PackedScene).instantiate()
		var mesh := (shell.get_node("Skinned") as MeshInstance3D).mesh
		shell.free()
		return mesh
	return null


## Two skinned meshes draw the same triangles: corner by corner (the glTF import re-indexes the
## vertices but keeps the triangle order), the same position and the same bones at the same weights.
func _skin_arrays_equal(p_a: Mesh, p_b: Mesh) -> bool:
	if p_a == null or p_b == null or p_a.get_surface_count() != p_b.get_surface_count():
		return false
	for surface in p_a.get_surface_count():
		var a := p_a.surface_get_arrays(surface)
		var b := p_b.surface_get_arrays(surface)
		var ca := _corner_list(a)
		var cb := _corner_list(b)
		if ca.size() != cb.size():
			return false
		var va: PackedVector3Array = a[Mesh.ARRAY_VERTEX]
		var vb: PackedVector3Array = b[Mesh.ARRAY_VERTEX]
		var ba: PackedInt32Array = a[Mesh.ARRAY_BONES]
		var bb: PackedInt32Array = b[Mesh.ARRAY_BONES]
		var wa: PackedFloat32Array = a[Mesh.ARRAY_WEIGHTS]
		var wb: PackedFloat32Array = b[Mesh.ARRAY_WEIGHTS]
		if ba.size() != va.size() * 4 or bb.size() != vb.size() * 4 or wa.size() != ba.size() or wb.size() != bb.size():
			return false
		for corner in ca.size():
			var x := ca[corner]
			var y := cb[corner]
			if not va[x].is_equal_approx(vb[y]):
				return false
			var weights_a := {}
			var weights_b := {}
			for slot in 4:
				if wa[x * 4 + slot] > 0.0:
					weights_a[ba[x * 4 + slot]] = snappedf(wa[x * 4 + slot], 1e-4)
				if wb[y * 4 + slot] > 0.0:
					weights_b[bb[y * 4 + slot]] = snappedf(wb[y * 4 + slot], 1e-4)
			if weights_a != weights_b:
				return false
	return true


func _corner_list(p_arrays: Array) -> PackedInt32Array:
	if p_arrays[Mesh.ARRAY_INDEX] != null:
		return p_arrays[Mesh.ARRAY_INDEX]
	var corners := PackedInt32Array()
	for index in (p_arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array).size():
		corners.append(index)
	return corners


## A pose track CSV as rows of Lib.pose_row numbers (empty when it does not parse).
func _read_pose_track(p_path: String) -> Array:
	var file := FileAccess.open(p_path, FileAccess.READ)
	if file == null:
		return []
	var header := file.get_line().split(",")
	if header.size() < 1 + Lib.POSE_STRIDE or header[0] != "frame" or (header.size() - 1) % Lib.POSE_STRIDE != 0:
		return []
	var rows: Array = []
	while not file.eof_reached():
		var line := file.get_line()
		if line.is_empty():
			continue
		var cells := line.split(",")
		if cells.size() != header.size() or int(cells[0]) != rows.size():
			return []
		var values := PackedFloat32Array()
		for index in range(1, cells.size()):
			values.append(float(cells[index]))
		rows.append(values)
	return rows


## A user argument the export ran with (export_manifest.json user_args).
func _user_arg(p_manifest: Dictionary, p_flag: String, p_default: String) -> String:
	for arg: Variant in p_manifest.get("user_args", []):
		if String(arg).begins_with(p_flag + "="):
			return String(arg).substr(p_flag.length() + 1)
	return p_default


## A node's world transform outside the tree: its local transforms multiplied up to the scene root.
func _global(p_node: Node3D) -> Transform3D:
	var transform := p_node.transform
	var parent := p_node.get_parent()
	while parent is Node3D:
		transform = (parent as Node3D).transform * transform
		parent = parent.get_parent()
	return transform


## Every bone's skeleton-space pose at p_time from the animation's rotation keys: each bone's
## stored pose (position, rotation, scale; the scene stores zero positions, not its rests), its
## rotation replaced where the animation has a rotation track for it, times its parent's pose.
func _animated_bones(p_skeleton: Skeleton3D, p_animation: Animation, p_time: float) -> Array[Transform3D]:
	var rotations := {}
	for track in p_animation.get_track_count():
		if p_animation.track_get_type(track) == Animation.TYPE_ROTATION_3D:
			var path := p_animation.track_get_path(track)
			rotations[String(path.get_concatenated_subnames())] = p_animation.rotation_track_interpolate(track, p_time)
	var poses: Array[Transform3D] = []
	for bone in p_skeleton.get_bone_count():
		var rotation := p_skeleton.get_bone_pose_rotation(bone)
		var name := p_skeleton.get_bone_name(bone)
		if rotations.has(name):
			rotation = rotations[name] as Quaternion
		var local := Transform3D(Basis(rotation).scaled_local(p_skeleton.get_bone_pose_scale(bone)), p_skeleton.get_bone_pose_position(bone))
		var parent := p_skeleton.get_bone_parent(bone)
		poses.append(poses[parent] * local if parent >= 0 else local)
	return poses


func _material_label(p_material: Dictionary) -> String:
	var name := String(p_material.get("name", ""))
	return String(p_material["id"]) if name.is_empty() else "%s (%s)" % [p_material["id"], name]


## A track CSV as transforms, one per row (empty when it does not parse).
func _read_track(p_path: String) -> Array:
	var file := FileAccess.open(p_path, FileAccess.READ)
	if file == null or file.get_line() != "frame,m00,m01,m02,m03,m10,m11,m12,m13,m20,m21,m22,m23":
		return []
	var rows: Array = []
	while not file.eof_reached():
		var line := file.get_line()
		if line.is_empty():
			continue
		var cells := line.split(",")
		if cells.size() != 13 or int(cells[0]) != rows.size():
			return []
		var values: Array = []
		for index in range(1, 13):
			values.append(float(cells[index]))
		rows.append(Lib.rows_to_transform(values))
	return rows


## JSON numbers come back as floats.
func _int_counts(p_counts: Dictionary) -> Dictionary:
	var counts := {}
	for key: String in p_counts:
		counts[key] = int(p_counts[key])
	return counts


func _approximations(p_scene: Dictionary) -> Dictionary:
	var found := {}
	for entry: Dictionary in p_scene["approximations"]:
		found[String(entry["id"])] = entry["items"]
	return found


## Every exported texture is a PNG of its stated size, and the textures the scene's own nodes use
## (material albedo textures, rect-light textures, projectors) are written byte for byte.
func _check_textures(p_dir: String, p_scene: Dictionary) -> void:
	var files := {}
	for texture: Dictionary in p_scene["textures"]:
		var bytes := FileAccess.get_file_as_bytes(p_dir.path_join(String(texture["file"])))
		var image := Image.new()
		var ok := not bytes.is_empty() and image.load_png_from_buffer(bytes) == OK
		_check(ok and image.get_size() == Vector2i(int(texture["size"][0]), int(texture["size"][1])), "%s is a PNG of its stated size" % texture["file"])
		files[String(texture["id"])] = bytes
	var materials := {}
	for material: Dictionary in p_scene["materials"]:
		materials[String(material["id"])] = material
	var shell := (load(_scene_path) as PackedScene).instantiate()
	shell.set_meta("skip_runtime", true)
	# A NoiseTexture2D makes its image in a deferred call after it loads (Displacement Cliff's rock):
	# give the main loop the frames it needs before reading it, and fail rather than compare nothing.
	var pending := 0
	for frame in 30:
		pending = 0
		for material_node in shell.find_children("*", "GeometryInstance3D", true, false):
			var override := (material_node as GeometryInstance3D).material_override as BaseMaterial3D
			if override != null and override.albedo_texture is NoiseTexture2D and override.albedo_texture.get_image() == null:
				pending += 1
		if pending == 0:
			break
		await process_frame
	_check(pending == 0, "every generated albedo texture has its image (%d still empty)" % pending)
	var compared := {}
	for instance: Dictionary in p_scene["instances"]:
		var kind := String(instance["kind"])
		if kind == "multimesh":
			var multimesh_node := shell.get_node_or_null(NodePath(String(instance["node"]))) as MultiMeshInstance3D
			if multimesh_node == null or multimesh_node.multimesh == null or multimesh_node.multimesh.mesh == null:
				continue
			for surface in (instance["materials"] as Array).size():
				var multimesh_material := multimesh_node.material_override as BaseMaterial3D
				if multimesh_node.material_override == null:
					multimesh_material = multimesh_node.multimesh.mesh.surface_get_material(surface) as BaseMaterial3D
				var exported: Dictionary = materials.get(String(instance["materials"][surface]), {})
				if multimesh_material == null or multimesh_material.albedo_texture == null:
					_check(exported.get("albedo_texture") == null, "%s surface %d has no texture" % [instance["node"], surface])
					continue
				compared[String(exported.get("albedo_texture", ""))] = true
				_check(files.get(String(exported.get("albedo_texture", "")), PackedByteArray()) == _source_png(multimesh_material.albedo_texture), "%s surface %d texture is the scene's" % [instance["node"], surface])
			continue
		var node := shell.get_node_or_null(NodePath(String(instance["node"]))) as MeshInstance3D
		if node == null or not (kind in ["node", "skeletal"]):
			continue
		for surface in (instance["materials"] as Array).size():
			var source_surface := surface
			if instance.has("skin_part"):
				source_surface = int(instance["skin_part"]["surfaces"][surface])
			var material: Dictionary = materials.get(String(instance["materials"][surface]), {})
			if node.get_active_material(source_surface) is ShaderMaterial:
				var shader_material := node.get_active_material(source_surface) as ShaderMaterial
				for name: String in material.get("shader", {}).get("uniforms", {}):
					var uniform: Dictionary = material["shader"]["uniforms"][name]
					if uniform.has("texture"):
						compared[String(uniform["texture"])] = true
						_check(files.get(String(uniform["texture"]), PackedByteArray()) == _source_png(shader_material.get_shader_parameter(name)), "%s uniform %s texture is the scene's" % [instance["node"], name])
				continue
			var source := node.get_active_material(source_surface) as BaseMaterial3D
			if source == null or source.albedo_texture == null:
				_check(material.get("albedo_texture") == null, "%s surface %d has no texture" % [instance["node"], surface])
				continue
			compared[String(material.get("albedo_texture", ""))] = true
			_check(files.get(String(material.get("albedo_texture", "")), PackedByteArray()) == _source_png(source.albedo_texture), "%s surface %d texture is the scene's" % [instance["node"], surface])
	for light: Dictionary in p_scene["lights"]:
		var node := shell.get_node_or_null(NodePath(String(light["node"]))) as Light3D
		if node == null:
			continue
		if node.light_projector != null:
			compared[String(light["projector"])] = true
			_check(files.get(String(light["projector"]), PackedByteArray()) == _source_png(node.light_projector), "%s projector is the scene's" % light["node"])
		if node is AreaLight3D and (node as AreaLight3D).area_texture != null:
			compared[String(light["area"]["texture"])] = true
			_check(files.get(String(light["area"]["texture"]), PackedByteArray()) == _source_png((node as AreaLight3D).area_texture), "%s rect texture is the scene's" % light["node"])
	var compared_ids: Array = compared.keys()
	compared_ids.sort()
	var texture_ids: Array = files.keys()
	texture_ids.sort()
	_check(compared_ids == texture_ids, "every texture was compared with its source (%s of %s)" % [compared_ids, texture_ids])
	shell.free()


## The PNG of a scene texture, from a fresh copy: the dummy renderer of a headless run keeps the
## image of a texture it creates, not of one a GradientTexture2D replaced after a placeholder. A
## NoiseTexture2D keeps its own image (a copy would make it again in a later deferred call), so it
## is read as it is.
func _source_png(p_texture: Texture2D) -> PackedByteArray:
	if p_texture is NoiseTexture2D:
		return Lib.texture_png(p_texture)
	return Lib.texture_png(p_texture.duplicate() as Texture2D)


func _check_library(p_dir: String, p_scene: Dictionary) -> void:
	var nodes := _gltf_meshes(p_dir.path_join("library.glb"))
	_check(nodes.size() == (p_scene["meshes"] as Array).size(), "library.glb has one mesh node per scene mesh (%d)" % nodes.size())
	for mesh: Dictionary in p_scene["meshes"]:
		var name := String(mesh["gltf_node"])
		_check(nodes.has(name), "library.glb has node %s" % name)
		if not nodes.has(name):
			continue
		var imported: Dictionary = nodes[name]
		_check(int(imported["triangles"]) == int(mesh["triangles"]), "%s keeps %d triangles (%d)" % [name, int(mesh["triangles"]), int(imported["triangles"])])
		var aabb: AABB = imported["aabb"]
		var stated := AABB(_vector(mesh["aabb"]["position"]), _vector(mesh["aabb"]["size"]))
		# An ArrayMesh pads a flat axis of its bounds by 1e-5 (a PlaneMesh's height), so a small
		# absolute tolerance.
		_check((aabb.position - stated.position).length() <= 1e-4 and (aabb.size - stated.size).length() <= 1e-4, "%s keeps its bounds" % name)
		_check(Transform3D(imported["transform"]).is_equal_approx(Transform3D.IDENTITY), "%s sits at the origin" % name)


func _check_axes(p_dir: String) -> void:
	var nodes := _gltf_meshes(p_dir.path_join("axes.glb"))
	var expected := {"axis_o": Vector3.ZERO, "axis_x": Vector3.RIGHT, "axis_y": Vector3.UP, "axis_z": Vector3.BACK}
	for name: String in expected:
		_check(nodes.has(name), "axes.glb has %s" % name)
		if nodes.has(name):
			var center: Vector3 = (nodes[name]["aabb"] as AABB).get_center()
			_check(center.is_equal_approx(expected[name]), "%s is centered at %s (%s)" % [name, expected[name], center])


## Every camera row against the camera's pose: the static pose of the kitbash, yard and hall
## cameras, and for Upscaler Torture the pose recomputed from the scene's curve (the timeline's
## progress for that frame, then the look-at target), plus the cut: the only large jump in the path
## is at the cut frame.
func _check_camera_track(p_dir: String, p_scene: Dictionary) -> void:
	var shell := (load(_scene_path) as PackedScene).instantiate() as Node3D
	shell.set_meta("skip_runtime", true)
	var torture := _scene_path == String(SCENES["torture"]["scene"])
	var perf := _scene_path == String(SCENES["perf"]["scene"])
	var camera := shell.get_node(_camera_name) as Camera3D
	var pose := camera.transform.orthonormalized()
	var follow := shell.get_node_or_null("CameraPath/CameraFollow") as PathFollow3D
	var curve: Curve3D = null
	if torture:
		curve = (shell.get_node("CameraPath") as Path3D).curve
		_check(follow.rotation_mode == PathFollow3D.ROTATION_NONE and _global(follow.get_parent() as Node3D).is_equal_approx(Transform3D.IDENTITY), "the torture camera follows its path without rotation, from the origin")
	var origins := PackedVector3Array()
	var file := FileAccess.open(p_dir.path_join("camera_track.csv"), FileAccess.READ)
	_check(file != null, "camera_track.csv opens")
	if file == null:
		shell.free()
		return
	_check(file.get_line() == "frame,px,py,pz,qx,qy,qz,qw,fov_deg,near,far", "camera_track.csv header")
	var rows := 0
	var off := 0
	while not file.eof_reached():
		var line := file.get_line()
		if line.is_empty():
			continue
		var cells := line.split(",")
		if cells.size() != 11 or int(cells[0]) != rows:
			off += 1
			rows += 1
			continue
		var q := Quaternion(float(cells[4]), float(cells[5]), float(cells[6]), float(cells[7]))
		var row_pose := Transform3D(Basis(q), Vector3(float(cells[1]), float(cells[2]), float(cells[3])))
		origins.append(row_pose.origin)
		if torture:
			# The follower sits on the curve at the timeline's progress; the camera looks at the
			# timeline's target from there (-Z forward, +Y up).
			var position := curve.sample_baked(_torture_progress(rows) * curve.get_baked_length(), follow.cubic_interp)
			pose = Transform3D(Basis.looking_at(TORTURE_TARGET - position, Vector3.UP), position)
		elif perf:
			# NextGI Perf's CaptureCam walks the layout's spline (#33).
			pose = Transform3D(PerfLayout.spline_basis(rows), PerfLayout.spline_position(rows))
		if not _transforms_close(row_pose, pose, 1e-4) or absf(float(cells[8]) - camera.fov) > 1e-6:
			off += 1
		rows += 1
	_check(rows == int(p_scene["frames"]), "camera_track.csv has %d rows (%d)" % [int(p_scene["frames"]), rows])
	_check(off == 0, "every camera row is %s's pose and fov (%d differ)" % [_camera_name, off])
	if torture:
		var jumps := PackedInt32Array()
		var still := 0
		for index in range(1, origins.size()):
			var step := origins[index].distance_to(origins[index - 1])
			if step > 0.5:
				jumps.append(index)
			if index < 200 and step == 0.0:
				still += 1
		_check(jumps == PackedInt32Array([TORTURE_CUT]), "the path's only jump is the cut at frame %d (%s)" % [TORTURE_CUT, jumps])
		_check(still == 199, "the camera holds still through frames 0 to 199 (%d still steps)" % still)
	shell.free()


## checks.camera_far_rows recomputed from the exported files alone: the camera rows of
## camera_track.csv (pose, field of view and far plane, at the viewport aspect scene.json records),
## and every placement's bounds, its mesh's (or skeletal mesh's) aabb at its transform, or at every
## row of its track for a mover. A row counts when some placement reaches past the far plane inside
## the view (Lib.box_past_far, unit-tested above).
func _check_camera_far(p_dir: String, p_scene: Dictionary) -> void:
	var project: Dictionary = p_scene["rendering"]["project"]
	var aspect := float(project.get("display/window/size/viewport_width", 0)) / maxf(float(project.get("display/window/size/viewport_height", 0)), 1.0)
	_check(aspect > 0.0, "scene.json records the viewport size")
	var keep_height := String(p_scene["camera"]["fov_axis"]) == "vertical"
	var local_boxes := {}
	for mesh: Dictionary in p_scene["meshes"]:
		local_boxes[String(mesh["id"])] = AABB(_vector(mesh["aabb"]["position"]), _vector(mesh["aabb"]["size"]))
	for asset: Dictionary in p_scene["skeletal_meshes"]:
		local_boxes[String(asset["id"])] = AABB(_vector(asset["aabb"]["position"]), _vector(asset["aabb"]["size"]))
	var still: Array[AABB] = []
	var moving: Array = []
	for instance: Dictionary in p_scene["instances"]:
		var kind := String(instance["kind"])
		var local: AABB = local_boxes.get(String(instance.get("skeletal" if kind == "skeletal" else "mesh", "")), AABB())
		if kind == "multimesh" or kind == "gridmap":
			for rows: Array in instance["instances"]:
				still.append(Lib.rows_to_transform(rows) * local)
		elif instance.get("track") != null:
			moving.append([local, _read_track(p_dir.path_join(String(instance["track"])))])
		else:
			still.append(Lib.rows_to_transform(instance["transform"]) * local)
	var union := AABB()
	for index in still.size():
		union = still[index] if index == 0 else union.merge(still[index])
	var file := FileAccess.open(p_dir.path_join("camera_track.csv"), FileAccess.READ)
	if file == null:
		_check(false, "camera_track.csv opens for the far-plane recount")
		return
	file.get_line()
	var counted := 0
	var row := 0
	var last_pose := ""
	var still_past := false
	while not file.eof_reached():
		var line := file.get_line()
		if line.is_empty():
			continue
		var cells := line.split(",")
		var q := Quaternion(float(cells[4]), float(cells[5]), float(cells[6]), float(cells[7]))
		var camera := Transform3D(Basis(q), Vector3(float(cells[1]), float(cells[2]), float(cells[3])))
		var planes := Lib.far_planes(camera, float(cells[8]), keep_height, aspect, float(cells[10]))
		var pose := line.substr(line.find(","))
		if pose != last_pose:
			last_pose = pose
			still_past = false
			if not still.is_empty() and Lib.box_past_far(union, planes):
				for box: AABB in still:
					if Lib.box_past_far(box, planes):
						still_past = true
						break
		var past := still_past
		for entry: Array in moving:
			var rows: Array = entry[1]
			if not past and row < rows.size() and Lib.box_past_far((rows[row] as Transform3D) * (entry[0] as AABB), planes):
				past = true
		if past:
			counted += 1
		row += 1
	_check(counted == int(p_scene["checks"]["camera_far_rows"]), "checks.camera_far_rows is the number of rows on which a placement reaches past the far plane, recomputed from the export (%d, %d)" % [counted, int(p_scene["checks"]["camera_far_rows"])])


## torture_timeline.gd's path progress for a frame.
func _torture_progress(p_frame: int) -> float:
	if p_frame < 200:
		return 0.0
	if p_frame < 400:
		return float(p_frame - 200) / 199.0 * 0.45
	return 0.78 + clampf(float(p_frame - 400) / 199.0, 0.0, 1.0) * 0.22


## CPU radiance and RGBE checks; check_ue_export_sky.gd separately compares the actual renderer.
func _check_sky(p_dir: String, p_scene: Dictionary) -> void:
	var sky_entry: Dictionary = p_scene["environment"]["sky"]
	_check(String(sky_entry.get("panorama", "")) == "sky.hdr" and String(sky_entry.get("panorama_projection", "")) == "godot_equirect", "the environment names sky.hdr")
	var decoded := Lib.decode_hdr(FileAccess.get_file_as_bytes(p_dir.path_join("sky.hdr")))
	_check(not decoded.has("error"), "sky.hdr decodes")
	if decoded.has("error"):
		return
	var width := int(decoded["width"])
	var height := int(decoded["height"])
	_check(width == Lib.SKY_WIDTH and height == Lib.SKY_HEIGHT, "sky.hdr is %dx%d" % [Lib.SKY_WIDTH, Lib.SKY_HEIGHT])
	var shell := (load(_scene_path) as PackedScene).instantiate()
	shell.set_meta("skip_runtime", true)
	var environment := (shell.get_node("WorldEnvironment") as WorldEnvironment).environment
	var sun := shell.get_node("Sun") as DirectionalLight3D
	var suns := [{
		"direction": sun.transform.basis.z.normalized(),
		"color": sun.light_color.srgb_to_linear(),
		"energy": sun.light_energy,
		"size": deg_to_rad(sun.light_angular_distance),
	}]
	var sky := environment.sky.sky_material as ProceduralSkyMaterial
	var worst := 0.0
	for sample: Vector2i in [Vector2i(0, 0), Vector2i(100, 60), Vector2i(256, 127), Vector2i(300, 128), Vector2i(511, 255), Vector2i(64, 90)]:
		var expected := Lib.procedural_sky_radiance(sky, suns, Lib.panorama_direction(sample.x, sample.y, width, height))
		var base := (sample.y * width + sample.x) * 3
		var pixels: PackedFloat32Array = decoded["pixels"]
		var peak := maxf(expected.r, maxf(expected.g, expected.b))
		for channel in 3:
			worst = maxf(worst, absf(pixels[base + channel] - [expected.r, expected.g, expected.b][channel]) / peak)
	_check(worst < 0.01, "sky.hdr holds the procedural sky (worst relative error %f)" % worst)
	var zenith := Lib.procedural_sky_radiance(sky, [], Vector3.UP)
	_check(zenith.is_equal_approx(sky.sky_top_color.srgb_to_linear()), "the zenith is the linear sky top color")
	shell.free()


## Mesh nodes of a glTF file: name -> {triangles, aabb, transform}.
func _gltf_meshes(p_path: String) -> Dictionary:
	var document := GLTFDocument.new()
	var state := GLTFState.new()
	var result := {}
	if document.append_from_file(p_path, state) != OK:
		_check(false, "%s imports" % p_path.get_file())
		return result
	var root_node := document.generate_scene(state)
	var stack: Array[Node] = [root_node]
	while not stack.is_empty():
		var node: Node = stack.pop_back()
		if node is MeshInstance3D and (node as MeshInstance3D).mesh != null:
			var mesh := (node as MeshInstance3D).mesh
			var triangles := 0
			for surface in mesh.get_surface_count():
				var arrays := mesh.surface_get_arrays(surface)
				var indices: Variant = arrays[Mesh.ARRAY_INDEX]
				triangles += (indices as PackedInt32Array).size() / 3 if indices != null else (arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array).size() / 3
			result[String(node.name)] = {"triangles": triangles, "aabb": mesh.get_aabb(), "transform": (node as Node3D).transform}
		for child in node.get_children():
			stack.append(child)
	root_node.free()
	return result


func _transforms_close(p_a: Transform3D, p_b: Transform3D, p_epsilon: float = EPSILON) -> bool:
	for axis in 3:
		if not (p_a.basis[axis] - p_b.basis[axis]).length() <= p_epsilon:
			return false
	return (p_a.origin - p_b.origin).length() <= p_epsilon


func _vector(p_value: Array) -> Vector3:
	return Vector3(float(p_value[0]), float(p_value[1]), float(p_value[2]))


func _read_json(p_path: String) -> Variant:
	var text := FileAccess.get_file_as_string(p_path)
	if text.is_empty():
		return null
	return JSON.parse_string(text)
