			"ue": { "group": "Lumen total", "columns": ["GPU/GlobalDistanceFieldUpdate", "GPU/LumenSceneUpdate", "GPU/UpdateLumenSceneBuffers", "GPU/LumenSceneLighting", "GPU/LumenScreenProbeGather", "GPU/LumenReflections"] }
