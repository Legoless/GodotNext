; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotNext Testbed"
config/description="GodotNext P0 testbed: seeded quality and legacy baseline scenes. Regenerate with res://generators/build_all.gd."
config/features=PackedStringArray("4.8", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="vulkan"
anti_aliasing/quality/use_debanding=false
lights_and_shadows/use_physical_light_units=false
