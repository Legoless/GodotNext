[sub_resource type="Shader" id="Shader_wcb82"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;
uniform sampler2D stripes : source_color, filter_linear, repeat_enable;
uniform float time_offset = 0.0;
uniform float scroll_speed = 2.0;
void fragment() {
	vec3 color = texture(stripes, UV + vec2(TIME * scroll_speed + time_offset, 0.0)).rgb;
	ALBEDO = color * 3.0;
}
"

