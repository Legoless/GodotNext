[sub_resource type="Shader" id="Shader_u8vhb"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;
uniform sampler2D stripes : source_color, filter_linear, repeat_enable;
uniform float time_offset = 0.0;
void fragment() {
	vec3 color = texture(stripes, UV + vec2(TIME * 2.0 + time_offset, 0.0)).rgb;
	ALBEDO = vec3(0.0);
	EMISSION = color * 3.0;
}
"

