#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

if "RD_GLSL" in env["BUILDERS"]:
    gl_include_files = [str(f) for f in Glob("*_inc.glsl")]
    glsl_files = [str(f) for f in Glob("*.glsl") if str(f) not in gl_include_files]

    env.Depends([f + ".gen.h" for f in gl_include_files], ["#glsl_builders.py"])
    env.Depends([f + ".gen.h" for f in glsl_files], gl_include_files + ["#glsl_builders.py"])
    # GodotNext: nextgeo_shading_bins (#158). resolve_compute.glsl is the Forward+ fragment stage
    # (#include_stage), so it is rebuilt whenever that template or one of its includes changes.
    env.Depends(
        "resolve_compute.glsl.gen.h",
        ["../forward_clustered/scene_forward_clustered.glsl"]
        + [str(f) for f in Glob("../forward_clustered/*_inc.glsl")]
        + [str(f) for f in Glob("../*_inc.glsl")],
    )
    # GodotNext: vsm_nanite (#217), nextgeo_mesh_raster (#154). VSM_VIEW in cluster_cull.glsl and
    # NEXTGEO_RASTER_DEPTH_ONLY in raster_material_{hw,hw_mesh,sw}.glsl include parent VSM headers.
    vsm_includes = [str(f) for f in Glob("../vsm_*_inc.glsl")]
    env.Depends("cluster_cull.glsl.gen.h", vsm_includes)
    env.Depends("raster_material_hw.glsl.gen.h", vsm_includes)
    env.Depends("raster_material_hw_mesh.glsl.gen.h", vsm_includes)
    env.Depends("raster_material_sw.glsl.gen.h", vsm_includes)

    for glsl_file in gl_include_files:
        env.GLSL_HEADER(glsl_file)
    for glsl_file in glsl_files:
        env.RD_GLSL(glsl_file)
